{
  "name": "fursim",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive 3D WebGL2/GPGPU fur physics and Marschner hair shading simulation for a stylized creature across studio, nature, and live AR camera environments.",
  "scripts": {
    "dev": "vp dev --port=3000 --host=0.0.0.0",
    "build": "vp build",
    "lint": "tsc --noEmit",
    "start": "node server.js",
    "desktop:build": "vp build && dotnet build desktop/DesktopMochi.csproj -c Release",
    "desktop": "desktop\\bin\\Release\\net10.0-windows\\DesktopMochi.exe",
    "test": "node adversarial_assessor.js",
    "prepare": "vp config"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  }
}
